DATABASE_URL=postgresql+psycopg://user:password@host/echo
# LLM for feedback analysis: the first key set is used (Groq, then xAI Grok, then Gemini).
# With none set, analysis falls back to the built-in lexicon.
GROQ_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
JWT_SECRET=change-me-to-a-random-secure-secret-key
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5180
